use flake
watch_file flake.lock

# This project's own GitHub fine-grained token is in the git-ignored
# .envrc.local (written by the dev-workflow plugin's store-gh-token.sh):
#
#   export GH_TOKEN="github_pat_..."
#
# The token can access only this repository. git uses SSH and needs no token.
source_env_if_exists .envrc.local

if [ -z "${GH_TOKEN:-}" ]; then
  log_error "GH_TOKEN is not set: gh would use your global login instead of this project's token."
  log_error "Set up the token with the dev-workflow github-token skill."
fi
